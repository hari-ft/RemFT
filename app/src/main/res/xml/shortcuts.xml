<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="25">
    <shortcut
        android:shortcutId="new_task"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add"
        android:shortcutShortLabel="@string/app_shortcut_new_task_short"
        android:shortcutLongLabel="@string/app_shortcut_new_task_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="remft://add"
            android:targetPackage="com.ftapps.remft"
            android:targetClass="com.ftapps.remft.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="today"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_today"
        android:shortcutShortLabel="@string/app_shortcut_today_short"
        android:shortcutLongLabel="@string/app_shortcut_today_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="remft://open"
            android:targetPackage="com.ftapps.remft"
            android:targetClass="com.ftapps.remft.MainActivity" />
    </shortcut>
</shortcuts>
