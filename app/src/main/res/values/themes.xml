<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Remft" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/remft_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Remft.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/remft_brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_orbit</item>
        <item name="windowSplashScreenAnimationDuration">760</item>
        <item name="postSplashScreenTheme">@style/Theme.Remft</item>
    </style>
</resources>
